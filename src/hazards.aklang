; Things that make the climb harder: wind gusts and falling rocks.
(= (hazards)
  (? (> INV 0) (<- INV (- INV 1)))
  (? (> GUST 0) (<- GUST (- GUST 1))
     (&& (> PH 400) (== 0 (rand 300)))
       (: (<- GUST 150) (<- GDIR (? (== 0 (rand 2)) -1 1)) (<- GS (+ 0.8 (min 1.2 (/ PH 2500))))))
  (? (&& (> PH 250) (== 0 (rand (max 25 (- 110 (// PH 20))))))
    (<- ROCKS (+> ROCKS [(clamp (int (+ PX (- (rand 301) 150))) 10 620) (+ CAM 520)])))
  (<- ROCKS (~? r=>(> r[1] (- CAM 60)) (~ r=>[r[0] (- r[1] 5)] ROCKS)))
  (for r ROCKS
    (? (&& (== INV 0) (< (abs (- (+ r[0] 8) (+ PX 7))) 16) (>= r[1] PH) (<= (- r[1] 14) (+ PH 30)))
      (: (<- LIVES (- LIVES 1)) (<- INV 90) (<- VH (min VH -2)) (<- ONG false)
         (<- ROCKS (~? q=>q!=r ROCKS))
         (? (<= LIVES 0) (: (<- OVER true) (<- MESSAGE "Crushed by a falling rock! Press R."))))))
  nil)
; sideways push on the hiker this frame
(= (wind) (? (> GUST 0) (* GDIR GS (? ONG 0.4 1)) 0))
