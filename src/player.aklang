; The hiker: input, jumping, gravity and landing.
(= (reset)
  (<- LED [35]) (<- KIND [0]) (<- WID [150]) (<- CRT [-1])
  (<- PX 75) (<- PH 0) (<- VH 0) (<- ONG true) (<- GI 0) (<- GX 35)
  (<- CAM 0) (<- OVER false) (<- T 0) (<- LIVES 3) (<- INV 0)
  (<- ROCKS []) (<- GUST 0) (<- MESSAGE START_MSG)
  nil)
(= (key k down)
  (? (has ["left" "a"] k) (<- LEFT down)
     (has ["right" "d"] k) (<- RIGHT down)
     (has ["up" "w" " " "space"] k) (<- UP down)
     down
     (? (has ["q" "esc"] k) (<- RUN false)
        (has ["r"] k) (reset)))
  nil)
(= (step)
  (? OVER nil
    (: (<- T (+ T 1))
       (hazards)
       lo=(max 0 (- (// PH GAP) 1))
       (grow (+ lo 5))
       (crumble lo)
       ; ride a moving ledge, and fall when a crumbling one goes
       (? (&& ONG (> GI 0))
         (: nx=(lx GI) (<- PX (+ PX (- nx GX))) (<- GX nx)
            (? (== CRT[GI] 0) (<- ONG false))))
       (<- PX (clamp (+ PX (+ (? RIGHT 4 0) (? LEFT -4 0)) (wind)) 0 626))
       (? (&& ONG UP) (: (<- VH 12.5) (<- ONG false)))
       (<- VH (- VH 0.55))
       nh=(+ PH VH)
       hit=nil
       (? (<= VH 0)
         (for i (.. lo (+ lo 3))
           top=(* i GAP)
           (? (&& hit==nil PH>=top nh<=top (solid i)
                  (|| i==0 (&& PX+10>=(lx i) PX+4<=(+ (lx i) WID[i]))))
             (<- hit i))))
       (? hit!=nil
         (: (<- PH (* hit GAP)) (<- VH 0) (<- ONG true) (<- GI hit) (<- GX (lx hit))
            (? (&& KIND[hit]==1 CRT[hit]<0) (<- CRT (set CRT hit 36))))
         (: (<- PH nh) (<- ONG false)))
       (<- BEST (max BEST PH))
       (<- CAM (max CAM (- PH 200)))
       (? (> (sy PH) 520) (: (<- OVER true) (<- MESSAGE "You fell! Press R to try again.")))))
  nil)
