; The hiker: input, jumping, gravity, landing and damage.
(= (reset)
  (<- OFF 0) (<- LED [35]) (<- KIND [0]) (<- WID [150]) (<- CRT [-1])
  (<- PX 75) (<- PH 0) (<- VH 0) (<- ONG true) (<- GI 0) (<- GX 35)
  (<- CAM 0) (<- OVER false) (<- T 0) (<- LIVES 3) (<- INV 0)
  (hazards_reset) (<- MESSAGE START_MSG)
  nil)
(= (key k down)
  (? (has ["left" "a"] k) (<- LEFT down)
     (has ["right" "d"] k) (<- RIGHT down)
     (has ["up" "w" " " "space"] k) (<- UP down)
     down
     (? (has ["q" "esc"] k) (<- RUN false)
        (has ["r"] k) (reset)))
  nil)
; a hazard hurts the hiker: true if it hit (not while briefly invulnerable)
(= (hurt msg)
  (? (> INV 0) false
    (: (<- LIVES (- LIVES 1)) (<- INV 90) (<- VH (min VH -2)) (<- ONG false)
       (? (<= LIVES 0) (: (<- OVER true) (<- MESSAGE msg)))
       true)))
(= (step)
  (? OVER nil
    (: (<- T (+ T 1))
       (? (> INV 0) (<- INV (- INV 1)))
       (hazards_step)
       lo=(near PH)
       (grow (+ lo 5))
       (crumble)
       (? (== 0 (% T 60)) (prune))
       ; ride a moving ledge, and fall when a crumbling one goes
       (? (&& ONG (> GI 0))
         (: nx=(lx GI) (<- PX (+ PX (- nx GX))) (<- GX nx)
            (? (< (crt GI) -1) (<- ONG false))))
       (<- PX (clamp (+ PX (+ (? RIGHT 4 0) (? LEFT -4 0)) PUSH) 0 626))
       (? (&& ONG UP) (: (<- VH 12.5) (<- ONG false)))
       (<- VH (- VH 0.55))
       nh=(+ PH VH)
       hit=nil
       (? (<= VH 0)
         (for i (.. lo (+ lo 3))
           (? (&& hit==nil PH>=(top i) nh<=(top i) (solid i)
                  (|| i==0 (&& PX+10>=(lx i) PX+4<=(+ (lx i) (wid i)))))
             (<- hit i))))
       (? hit!=nil
         (: (<- PH (top hit)) (<- VH 0) (<- ONG true) (<- GI hit) (<- GX (lx hit))
            (? (&& (kind hit)==1 (== (crt hit) -1)) (setcrt hit 36)))
         (: (<- PH nh) (<- ONG false)))
       (<- BEST (max BEST PH))
       (<- CAM (max CAM (- PH 200)))
       (? (> (sy PH) 520) (: (<- OVER true) (<- MESSAGE "You fell! Press R to try again.")))))
  nil)
