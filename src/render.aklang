; Everything that is drawn.
(= (draw_ledge cv i)
  y=(sy (* i GAP))
  x=(lx i)
  w=(wid i)
  k=(kind i)
  c=(crt i)
  (? (&& y>20 y<470 c>=-1 (|| c<0 c>12 (== 0 (% (// c 2) 2))))
    (: sh=(? (&& c>0 (== 0 (% T 2))) 2 0)
       (srect cv x+sh y w 14 (? k==1 TRAIL ROCK))
       (srect cv x+sh y+10 w 4 (? k==1 CRACK ROCK2))
       (srect cv x+sh y w 4 (? k==1 CRACK k==2 ICE GRASS))
       (? k==1 (for q [0.25 0.5 0.75] (srect cv (+ x (int (* w q))) y+4 3 10 CRACK)))))
  nil)
(= (draw cv)
  (fill cv SKY)
  ; stars drift down slowly as you climb
  (for s [[45 35] [118 60] [220 28] [370 46] [550 30] [600 92] [290 105] [80 140] [470 120] [330 15]]
    (srect cv s[0] (% (+ s[1] (// CAM 4)) 400) 3 3 SNOW))
  ; distant mountain silhouettes
  (for m [[-30 290 180] [125 250 200] [325 275 180] [475 240 210]]
    (scircle cv m[0]+m[2] (+ m[1] (// CAM 3)) m[2] ROCK2))
  ; ground at the foot of the mountain
  (? (< CAM 100)
    (: (srect cv 0 (sy 0) WW 120 (rgb 35 47 64))
       (srect cv 0 (sy 0) WW 4 GRASS)))
  (grow (+ (// CAM GAP) 12))
  (for i (.. (max 1 (near CAM)) (+ (// CAM GAP) 8))
    (draw_ledge cv i))
  (hazards_draw cv)
  ; little hiker (pixel art); bends the legs in the air, blinks after a hit
  PXI=(int PX)
  PY=(- (sy PH) 25)
  (? (|| INV==0 (== 0 (% (// INV 4) 2)))
    (: (srect cv PXI PY 14 18 RED)
       (srect cv PXI+3 PY-8 9 9 (rgb 236 183 132))
       (? ONG
         (: (srect cv PXI+1 PY+17 5 8 INK) (srect cv PXI+9 PY+17 5 8 INK))
         (: (srect cv PXI-1 PY+17 5 6 INK) (srect cv PXI+11 PY+17 5 6 INK)))
       (srect cv PXI-4 PY+3 5 12 TRAIL)))
  ; HUD
  (srrect cv 12 12 250 86 8 INK)
  (stext cv 24 20 "SUMMIT TRAIL" 22 WHITE)
  (stext cv 24 48 (fmt "HEIGHT %d m" (// PH 10)) 15 GOLD)
  (stext cv 150 48 (fmt "BEST %d m" (// BEST 10)) 15 GOLD)
  (for k (.. 0 LIVES) (srect cv (+ 24 (* k 22)) 74 16 12 RED))
  (srrect cv 272 12 358 72 8 INK)
  (stext cv 282 22 MESSAGE 15 WHITE)
  (stext cv 282 44 "LEFT/RIGHT or A/D: move   UP/W/SPACE: jump" 15 SNOW)
  (stext cv 282 64 "R: restart   Q: quit" 15 SNOW)
  (hazards_hud cv)
  (? OVER
    (: (srrect cv 150 190 340 110 16 INK)
       (stext cv 235 212 "GAME OVER" 22 GOLD)
       (stext cv 190 250 (fmt "You climbed %d m. Press R." (// BEST 10)) 16 WHITE)))
  nil)
