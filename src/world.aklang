; The endless mountain: ledges are made on demand and get harder with height.
(= (clamp v lo hi) (min hi (max lo v)))
(= (sy h) (int (- 385 (- h CAM))))
(= (grow n)
  (wh (< (# LED) n)
    i=(# LED)
    d=(min 60 i)
    roll=(rand 100)
    crumble=(+ 8 (// d 3))
    move=(+ crumble 6 (// d 4))
    kind=(? (< i 3) 0 (< roll crumble) 1 (< roll move) 2 0)
    (<- LED (+> LED (clamp (+ (lst LED) (- (rand 201) 100)) 10 480)))
    (<- KIND (+> KIND kind))
    (<- WID (+> WID (max 90 (- 150 i))))
    (<- CRT (+> CRT -1)))
  nil)
; where ledge i is right now (moving ledges slide)
(= (lx i) (? KIND[i]==2 (+ LED[i] (int (* 50 (sin (+ (/ T 45) i))))) LED[i]))
(= (solid i) CRT[i]!=0)
; crumbling ledges count down once stepped on, then vanish
(= (crumble lo)
  (for i (.. lo (+ lo 10))
    (? CRT[i]>0 (<- CRT (set CRT i (- CRT[i] 1)))))
  nil)
