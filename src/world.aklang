; The endless mountain. Ledges are made on demand and dropped once they are far below the camera,
; so memory and speed stay flat however high you climb.
(= (clamp v lo hi) (min hi (max lo v)))
(= (sy h) (int (- 385 (- h CAM))))
; ledge accessors (i is the absolute ledge number)
(= (kind i) KIND[i-OFF])
(= (wid i) WID[i-OFF])
(= (crt i) CRT[i-OFF])
(= (setcrt i v) (<- CRT (set CRT i-OFF v)) nil)
(= (top i) (* i GAP))
(= (solid i) (crt i)>=-1)
; where ledge i is right now (moving ledges slide)
(= (lx i) (? (kind i)==2 (+ LED[i-OFF] (int (* 50 (sin (+ (/ T 45) i))))) LED[i-OFF]))
(= (grow n)
  (wh (< (+ OFF (# LED)) n)
    i=(+ OFF (# LED))
    roll=(rand 100)
    k=(? (< i 3) 0 (< roll (crumble_pct i)) 1 (< roll (+ (crumble_pct i) (move_pct i))) 2 0)
    (<- LED (+> LED (clamp (+ (lst LED) (- (rand 201) 100)) 10 480)))
    (<- KIND (+> KIND k))
    (<- WID (+> WID (ledge_width i)))
    (<- CRT (+> CRT -1)))
  nil)
; forget ledges well below the camera (always keep 6 so a falling hiker can still land)
(= (prune)
  n=(- (// CAM GAP) 6 OFF)
  (? (> n 40)
    (: (<- LED (drop n LED)) (<- KIND (drop n KIND)) (<- WID (drop n WID)) (<- CRT (drop n CRT))
       (<- OFF (+ OFF n))))
  nil)
; a crumbling ledge counts down from 36 once stepped on, vanishes for 5 seconds (timer -300 up to -2),
; then grows back, so a broken ledge can never block the way up
(= (crumble)
  (for i (.. (near CAM) (+ OFF (# LED)))
    c=(crt i)
    (? c>1 (setcrt i (- c 1))
       c==1 (setcrt i -300)
       c<-1 (setcrt i (+ c 1))))
  nil)
; first ledge worth looking at for something at height h
(= (near h) (max OFF (max 0 (- (// h GAP) 1))))
