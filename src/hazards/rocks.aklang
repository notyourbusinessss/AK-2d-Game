; Falling rocks. A red "!" at the top of the screen warns where one is about to drop.
ROCKS=[]
(= (rocks_reset) (<- ROCKS []) nil)
(= (rocks_step)
  (? (&& (> PH (rock_start)) (== 0 (rand (rock_every PH))))
    (<- ROCKS (+> ROCKS [(clamp (int (+ PX (- (rand 301) 150))) 10 620) (+ CAM 520)])))
  (<- ROCKS (~? r=>(> r[1] (- CAM 60)) (~ r=>[r[0] (- r[1] 5)] ROCKS)))
  (for r ROCKS
    (? (&& (< (abs (- (+ r[0] 8) (+ PX 7))) 16) (>= r[1] PH) (<= (- r[1] 14) (+ PH 30)))
      (? (hurt "Crushed by a falling rock! Press R.") (<- ROCKS (~? q=>q!=r ROCKS)))))
  nil)
(= (rocks_draw cv)
  (for r ROCKS
    ry=(sy r[1])
    (? ry<0 (text cv r[0] 92 "!" 22 RED)
       (: (circle cv r[0]+8 ry-7 9 STONE) (circle cv r[0]+5 ry-9 3 ROCK2))))
  nil)
