; Summit Trail — an endless 8-bit-style climbing game written in Ak.
; Needs Ak 0.6.22 or newer. Run from this folder with: ak game.aklang
;   lib/      Ak's X11 window and canvas libraries (bundled)
;   src/      config (state), difficulty (all tuning), world (ledges), hazards/ (one file per hazard), player, render
(use "lib/x11.aklang")
(use "src/config.aklang")
(use "src/world.aklang")
(use "src/gfx.aklang")
(use "src/difficulty.aklang")
(use "src/hazards/index.aklang")
(use "src/player.aklang")
(use "src/render.aklang")

(= (main)
  ; start size: `ak game.aklang 2` for 2x, otherwise the biggest whole scale that fits the screen;
  ; after that the window can be resized freely and the game follows
  av=(args)
  s0=(? (> (# av) 0) (clamp (int (num av[0])) 1 4) (auto_scale))
  cv=(canvas (* WW s0) (* WH s0))
  win=(gui_open "Summit Trail - 8-bit Climbing Game" (* WW s0) (* WH s0) WW WH)   ; may grow, never shrink below 640x480
  (fit cv.w cv.h)
  (draw cv) (gui_present win cv)
  (wh RUN
    next=(+ (clock) 16)
    ; read every key event that arrives before the next frame is due
    ev=(gui_event win (max 0 (- next (clock))))
    (wh ev
      (? ev.type=="close" (<- RUN false)
         ev.type=="key" (key ev.key ev.down)
         ev.type=="resize" (: (<- cv (canvas ev.w ev.h)) (fit ev.w ev.h)))
      ev=(gui_event win (max 0 (- next (clock)))))
    (step)
    (draw cv)
    (gui_present win cv))
  (gui_close win)
  nil)
(main)
